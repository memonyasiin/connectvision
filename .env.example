# ConnectVision SaaS environment template
# Copy to `.env.local` and fill in real values.

# ── Database (MySQL — same Bluehost instance, separate logical DB) ─────────────
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=connectvision
DB_PORT=3306

# ── Pataa Core Sync (Tier 3 — cross-platform unified ecosystem) ───────────────
PATAA_CRM_BASE_URL=https://pataainternational.com
PATAA_CRM_LEAD_ENDPOINT=/api/crm/leads/intake
PATAA_CRM_SYNC_TOKEN=

PATAA_WORKOPS_BASE_URL=https://pataainternational.com/pataaworkops
PATAA_WORKOPS_SYNC_TOKEN=

# ── PataaWaa WhatsApp Gateway (Tier 5 — AI sales agent) ───────────────────────
PATAAWAA_BASE_URL=https://wa.pataainternational.com
PATAAWAA_GATEWAY_TOKEN=
PATAAWAA_WEBHOOK_SECRET=

# ── LLM agent (Tier 5 — autonomous conversational flow) ───────────────────────
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# ── Razorpay (subscriptions + one-time purchases) ─────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Multi-tenant deployment (Tier 4 — dynamic subdomains) ─────────────────────
TENANT_BASE_DOMAIN=connectvision.io
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# ── Auth / sessions ───────────────────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3100
