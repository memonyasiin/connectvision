# ConnectVision SaaS environment template
# Copy to `.env.local` and fill in real values.

# ── Database (MySQL — same Bluehost instance, separate logical DB) ─────────────
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=connectvision
DB_PORT=3306

# ── Pataa Core Sync (Tier 3 — cross-platform unified ecosystem) ───────────────
PATAA_CRM_BASE_URL=https://pataainternational.com
PATAA_CRM_LEAD_ENDPOINT=/api/crm/leads/intake
PATAA_CRM_SYNC_TOKEN=

PATAA_WORKOPS_BASE_URL=https://pataainternational.com/pataaworkops
PATAA_WORKOPS_SYNC_TOKEN=

# ── PataaWaa WhatsApp Gateway (Tier 5 — AI sales agent) ───────────────────────
PATAAWAA_BASE_URL=https://wa.pataainternational.com
PATAAWAA_GATEWAY_TOKEN=
PATAAWAA_WEBHOOK_SECRET=

# ── LLM (OpenAI-compatible) — Groq today, self-hostable tomorrow ──────────────
# Default = Groq (free, hosted). /api/ai/chat + sovereign-search read these.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# SELF-HOSTED SWITCH (no code change — set these + redeploy). Ollama/vLLM/TGI
# all expose the same OpenAI /chat/completions API:
#   LLM_BASE_URL=http://YOUR_GPU_SERVER:11434/v1   # Ollama default
#   LLM_API_KEY=ollama                              # any non-empty value
#   LLM_TEXT_MODEL=llama3.3
#   LLM_VISION_MODEL=llama3.2-vision
LLM_BASE_URL=
LLM_TEXT_MODEL=
LLM_VISION_MODEL=

# ── Razorpay (subscriptions + one-time purchases) ─────────────────────────────
# Live keys from Razorpay Dashboard → Settings → API Keys (toggle to Live).
# Webhook (Settings → Webhooks): URL https://connectvision.us/api/checkout/webhook
# events payment.captured / payment.failed / payment.authorized; the secret you
# type there must equal RAZORPAY_WEBHOOK_SECRET below. Absent ⇒ mock checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Resend transactional email (MODULE 15) ───────────────────────────────────
# API key from resend.com → API Keys (re_…). Also verify the connectvision.us
# domain in Resend (Domains → add SPF/DKIM DNS on Bluehost) or sends bounce.
# Absent ⇒ log-only mode (purchase emails are logged, not delivered).
RESEND_API_KEY=
CONNECTVISION_EMAIL_FROM=ConnectVision <connect@connectvision.us>
CONNECTVISION_EMAIL_REPLY_TO=support@connectvision.us

# ── GST tax invoice (MODULE 14) — seller details on the printable invoice ─────
# Absent ⇒ invoice renders "GSTIN-NOT-CONFIGURED" placeholders.
# CV_INVOICE_SELLER_NAME is the brand header; put the registered legal entity
# name as the first line of CV_INVOICE_SELLER_ADDRESS. STATE_CODE = first 2
# digits of GSTIN. PAN = chars 3–12 of GSTIN. SAC defaults to 998314.
CV_INVOICE_SELLER_NAME=ConnectVision
CV_INVOICE_SELLER_GSTIN=
CV_INVOICE_SELLER_PAN=
CV_INVOICE_SELLER_STATE_CODE=
CV_INVOICE_SELLER_ADDRESS=
# CV_INVOICE_SAC=998314
# CV_INVOICE_SERIES_PREFIX=CV/

# ── Multi-tenant deployment (Tier 4 — dynamic subdomains) ─────────────────────
TENANT_BASE_DOMAIN=connectvision.io
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# ── Auth / sessions ───────────────────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3100
