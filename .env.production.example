# ═════════════════════════════════════════════════════════════════════════════
# ConnectVision Core OS — Production Environment Freeze
# ═════════════════════════════════════════════════════════════════════════════
# Gitignored. The single source of truth for production secrets.
# Every CHANGE_ME below MUST be filled before pushing to Vercel.
# Mirror these to Vercel Project Settings → Environment Variables (production).
#
# Section legend:
#   [R] = required; deploy fails open if missing
#   [O] = optional; feature degrades silently if missing
#   [G] = generate fresh per environment (openssl rand)

# ─────────────────────────────────────────────────────────────────────────────
# 1 ▸ MySQL — high-velocity multi-tenant connection pooling
# ─────────────────────────────────────────────────────────────────────────────
# Pooled URL — used by EVERY serverless function. Must hit a connection
# pooler (PgBouncer-equivalent for MySQL: ProxySQL / PlanetScale pool /
# RDS proxy). Direct connections from Vercel functions will exhaust
# MySQL's max_connections in under a minute under traffic spikes.
#
# Query params explained:
#   connection_limit  : max conns this Lambda instance opens to the pool
#   pool_timeout      : seconds a query waits for a free conn before erroring
#   statement_cache_size : prepared-statement cache per connection (0 = off
#                          for poolers that don't preserve session state)
#   connect_timeout   : seconds before initial connection attempt fails
#   socket_timeout    : seconds per query before forcefully aborting

# [R] Pooled connection — used at runtime
DATABASE_URL="mysql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@pooled.connectvision-prod.internal:3306/connectvision?connection_limit=10&pool_timeout=15&statement_cache_size=0&connect_timeout=5&socket_timeout=30"

# [O] Direct (unpooled) URL — used only by `prisma migrate deploy` in CI
DIRECT_URL="mysql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@direct.connectvision-prod.internal:3306/connectvision?connect_timeout=15"

# [O] Read replica — for analytics / reporting routes that don't need fresh data
DATABASE_READ_REPLICA_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# 2 ▸ NextAuth (Auth.js v5)
# ─────────────────────────────────────────────────────────────────────────────

# [R][G] 32+ byte random. Generate with:  openssl rand -hex 32
NEXTAUTH_SECRET="CHANGE_ME_32_BYTE_RANDOM_HEX"
NEXTAUTH_URL="https://connectvision.io"

# [O] Session cookie domain — defaults to the request host. Override to
#     ".connectvision.io" if you want a single SSO cookie across all
#     *.connectvision.io tenant subdomains. Leave blank for per-tenant
#     session isolation (recommended; tenants don't share auth).
AUTH_COOKIE_DOMAIN=""

# ─────────────────────────────────────────────────────────────────────────────
# 3 ▸ Multi-tenant validation headers (service-to-service auth)
# ─────────────────────────────────────────────────────────────────────────────
# Service-to-service calls (cron → webhook, Flutter app → API, internal
# admin tools → workforce route) all carry the validation token in the
# X-ConnectVision-Validation-Token header. The runtime rejects requests
# missing it with 401. Rotate quarterly.

# [R][G] Per-environment HMAC. Generate with: openssl rand -hex 32
CV_VALIDATION_TOKEN="CHANGE_ME_32_BYTE_RANDOM_HEX"

# [R] Canonical header name. Centralized here so we can rename in one
#     deploy without code edits (the lib reads this value at runtime).
CV_VALIDATION_TOKEN_HEADER_NAME="X-ConnectVision-Validation-Token"

# [R] HMAC for backend-to-backend signed requests (Razorpay webhook
#     callbacks, PataaWaa inbound, cron-triggered jobs).
INTERNAL_SECRET="CHANGE_ME_32_BYTE_RANDOM_HEX"

# [R][G] Vercel cron convention. Vercel auto-injects this as the Bearer
#     token on cron-triggered Authorization headers. Workforce route
#     accepts either CRON_SECRET or INTERNAL_SECRET. Generate with:
#     openssl rand -hex 32
CRON_SECRET="CHANGE_ME_32_BYTE_RANDOM_HEX"

# [R] CORS allow-list — covers the apex, www, all customer subdomains,
#     and the Flutter app's WebView origin.
ALLOWED_ORIGINS="https://connectvision.io,https://www.connectvision.io,https://*.connectvision.io,capacitor://localhost,ionic://localhost"

# [R] Per-tenant identification headers — emitted by the edge middleware.
TENANT_HEADER_NAME="X-CV-Tenant"
TENANT_ROUTING_KEY_HEADER_NAME="X-CV-Routing-Key"

# ─────────────────────────────────────────────────────────────────────────────
# 4 ▸ Edge-proxy cache profile knobs — read by src/lib/vercelProxy.ts
# ─────────────────────────────────────────────────────────────────────────────
# Tunables for the stale-while-revalidate windows attached to every
# tenant response. Bump SWR conservatively — too short and the upstream
# gets hammered on traffic spikes; too long and operator edits take ages
# to propagate.
#
# Rule of thumb (verified at scale):
#   s-maxage = how long a fresh response is served from cache
#   stale-while-revalidate = how long a stale response is served while
#                            the next request triggers a background refresh

# Tenant HTML — operator-edit feedback loop matters; keep S_MAXAGE short
CV_HTML_S_MAXAGE_SEC="10"
CV_HTML_SWR_SEC="60"

# JSON edge responses (theme catalog, tenant manifest)
CV_JSON_S_MAXAGE_SEC="30"
CV_JSON_SWR_SEC="120"

# Flutter / cross-platform API responses — mobile clients tolerate
# longer cache windows and benefit massively from SWR on flaky networks.
# Default tuned for our PIA CRM Flutter app's read-heavy endpoints.
CV_FLUTTER_API_S_MAXAGE_SEC="60"
CV_FLUTTER_API_SWR_SEC="600"

# Static asset cache (1 year — Next emits hashed filenames)
CV_STATIC_MAX_AGE_SEC="31536000"

# Rotating handle baked into `x-cv-routing-key`. Bump to invalidate
# every tenant cache atomically on deploy.
CV_ROUTING_VERSION="v1"

# ─────────────────────────────────────────────────────────────────────────────
# 5 ▸ Pataa Core Sync (cross-platform integration)
# ─────────────────────────────────────────────────────────────────────────────

PATAA_CRM_BASE_URL="https://pataainternational.com"
PATAA_CRM_LEAD_ENDPOINT="/api/crm/leads/intake"
PATAA_CRM_SYNC_TOKEN="CHANGE_ME"

PATAA_WORKOPS_BASE_URL="https://pataainternational.com/pataaworkops"
PATAA_WORKOPS_SYNC_TOKEN="CHANGE_ME"

# ─────────────────────────────────────────────────────────────────────────────
# 6 ▸ PataaWaa WhatsApp gateway
# ─────────────────────────────────────────────────────────────────────────────

PATAAWAA_BASE_URL="https://wa.pataainternational.com"
PATAAWAA_GATEWAY_TOKEN="CHANGE_ME"
PATAAWAA_WEBHOOK_SECRET="CHANGE_ME_HMAC_SECRET"

# ─────────────────────────────────────────────────────────────────────────────
# 7 ▸ Notification channels (notificationEngine.ts)
# ─────────────────────────────────────────────────────────────────────────────

# DLT-registered transactional SMS gateway (MSG91 by default)
SMS_GATEWAY_URL="https://api.msg91.com/api/v5/flow"
SMS_GATEWAY_TOKEN="CHANGE_ME"

# ─────────────────────────────────────────────────────────────────────────────
# 8 ▸ LLM provider (autonomous WhatsApp agent)
# ─────────────────────────────────────────────────────────────────────────────

LLM_PROVIDER="groq"
LLM_API_KEY="CHANGE_ME"
LLM_MODEL="llama-3.3-70b-versatile"

# ─────────────────────────────────────────────────────────────────────────────
# 9 ▸ Razorpay (subscriptions + one-time + NPCI-standard UPI capture)
# ─────────────────────────────────────────────────────────────────────────────

RAZORPAY_KEY_ID="CHANGE_ME"
RAZORPAY_KEY_SECRET="CHANGE_ME"
RAZORPAY_WEBHOOK_SECRET="CHANGE_ME"

# ─────────────────────────────────────────────────────────────────────────────
# 10 ▸ Cloudflare / multi-tenant deployment (per Phase 3.4 playbook)
# ─────────────────────────────────────────────────────────────────────────────

TENANT_BASE_DOMAIN="connectvision.io"
CLOUDFLARE_ZONE_ID="CHANGE_ME"
CLOUDFLARE_API_TOKEN="CHANGE_ME"
CLOUDFLARE_KV_NAMESPACE_ID="CHANGE_ME"

VERCEL_API_TOKEN="CHANGE_ME"
VERCEL_PROJECT_ID="CHANGE_ME"

# ─────────────────────────────────────────────────────────────────────────────
# 11 ▸ Observability (wire after first 30 days of traffic)
# ─────────────────────────────────────────────────────────────────────────────

SENTRY_DSN=""
DD_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# 12 ▸ Feature flags (production cutover)
# ─────────────────────────────────────────────────────────────────────────────

# Toggle the workforce anti-fraud auto-flagger on / off without redeploy.
CV_FEATURE_WORKFORCE_AUTOFLAG="true"

# Toggle the marketplace catalog (set false during private-beta period).
CV_FEATURE_MARKETPLACE_PUBLIC="true"
